{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/portfolio/layout,_N_T_/portfolio/default/layout,_N_T_/portfolio/default/page,_N_T_/portfolio/default"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/portfolio/default/__PAGE__",
    "/portfolio/default",
    "/portfolio",
    "/_index"
  ]
}